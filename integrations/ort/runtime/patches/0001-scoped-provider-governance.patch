+
 Status TensorrtExecutionProvider::OnRunStart(const onnxruntime::RunOptions& /*run_options*/) {
+  ORT_RETURN_IF_NOT(scoped_allocator_.Begin(), "TensorRT requires an active, unambiguous request allocation scope");
+  // Retry a failed prior free before allowing a later request to use any DDS
+  // buffer. OnRunEnd is not called by ORT when OnRunStart itself fails.
+  for (auto& node : dds_output_allocator_maps_) {
+    for (auto& output : node.second) {
+      if (!output.second->Reset()) {
+        scoped_allocator_.End();
+        return ORT_MAKE_STATUS(ONNXRUNTIME, EP_FAIL, "TensorRT still retains a prior request's output allocation");
+      }
+    }
+  }
   return Status::OK();
 }
 
 Status TensorrtExecutionProvider::OnRunEnd(bool sync_stream, const onnxruntime::RunOptions& /*run_options*/) {
+  // Revoke allocation ownership even if device synchronization or cleanup fails.
+  const bool scope_ended = scoped_allocator_.End();
+  bool outputs_released = true;
+  for (auto& node : dds_output_allocator_maps_) {
+    for (auto& output : node.second) outputs_released = output.second->Reset() && outputs_released;
+  }
   if (sync_stream && external_stream_) {
     CUDA_RETURN_IF_ERROR(cudaStreamSynchronize(stream_));
   }
+  ORT_RETURN_IF_NOT(scope_ended && outputs_released, "TensorRT scope/output cleanup failed");
   return Status::OK();
 }
 
